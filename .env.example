# Local default uses SQLite. Replace with PostgreSQL when running the full Docker stack or deploying later.
DATABASE_URL=sqlite:///./network_monitor.db

# Monitoring behaviour
MONITOR_INTERVAL_SECONDS=2
FAILURE_THRESHOLD=3
DISABLE_BACKGROUND_MONITOR=false

# Local frontend origins
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Optional cross-project integration with Project 1: AI Helpdesk Copilot
HELPDESK_INTEGRATION_ENABLED=false
HELPDESK_API_URL=http://127.0.0.1:8001
HELPDESK_REQUESTER_NAME=Network Monitor
HELPDESK_REQUESTER_EMAIL=monitor@portfolio.local
